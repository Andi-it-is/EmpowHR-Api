    "migration:generate:prod": "NODE_ENV=production typeorm-ts-node-commonjs migration:generate src/migration/mysql/Migration -d src/data-source.ts",
    "migration:run:dev": "NODE_ENV=development typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "migration:run:prod": "NODE_ENV=production typeorm-ts-node-commonjs migration:run -d src/data-source.ts"
  },
